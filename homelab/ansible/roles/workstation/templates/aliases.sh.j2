# {{ ansible_managed }}
# Homelab kısayolları (roles/workstation). ~/.bashrc bu dosyayı yükler.

# kubectl
alias k=kubectl
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash)
  complete -o default -F __start_kubectl k
fi
alias kgp='kubectl get pods -A -o wide'
alias kgn='kubectl get nodes -L homelab/role -o wide'
alias kapps='kubectl -n argocd get applications'
alias kev='kubectl get events -A --sort-by=.lastTimestamp | tail -30'

# Port-forward: arayüzü localhost'a açar, VS Code "Ports" sekmesinden tarayıcıda açılır.
# Servis adları lab-ui içinde tek yerde tanımlı.
alias pf-grafana='lab-ui grafana'            # http://localhost:3000
alias pf-argocd='lab-ui argocd'              # http://localhost:8080
alias pf-prometheus='lab-ui prometheus'      # http://localhost:9090
alias pf-alertmanager='lab-ui alertmanager'  # http://localhost:9093
alias pf-n8n='lab-ui n8n'                    # http://localhost:5678
alias pf-all='lab-ui'

# Şifreler
alias pw-argocd="kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d; echo"
alias pw-grafana="kubectl -n monitoring get secret grafana-admin -o jsonpath='{.data.admin-password}' | base64 -d; echo"

{% if groups['floci'] | default([]) | length > 0 %}
# Floci (AWS emülatörü, k3s dışında)
alias awsl='aws --profile floci --endpoint-url http://{{ hostvars[groups['floci'][0]]['static_ip'] }}:{{ floci_port }}'
{% endif %}
