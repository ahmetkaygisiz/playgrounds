# {{ ansible_managed }}
# Floci: yerel AWS emülatörü. Terraform/AWS CLI -> http://{{ static_ip }}:{{ floci_port }}
name: floci

services:
  floci:
    image: {{ floci_image }}
    container_name: floci
    restart: unless-stopped
    ports:
      - "{{ floci_port }}:4566"
{% if floci_enable_docker_services | bool %}
      - "6379-6399:6379-6399"   # ElastiCache proxy portları
      - "7001-7099:7001-7099"   # RDS proxy portları
{% endif %}
    volumes:
      - floci-data:/app/data
{% if floci_enable_docker_services | bool %}
      - /var/run/docker.sock:/var/run/docker.sock
{% endif %}
    environment:
      # Üretilen URL'ler (ör. SQS QueueUrl) LAN'dan çözülebilsin
      FLOCI_HOSTNAME: "{{ static_ip }}"
      FLOCI_STORAGE_MODE: persistent
      FLOCI_STORAGE_PERSISTENT_PATH: /app/data
{% if floci_enable_docker_services | bool %}
      FLOCI_SERVICES_DOCKER_NETWORK: floci_default
{% endif %}

volumes:
  floci-data:
